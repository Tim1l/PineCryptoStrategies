//@version=6
indicator("Confirmed Higher-Timeframe Candles", overlay = true)

// Show the previous completed HTF candle, not the still-forming one.
string higherTimeframe = input.timeframe("60", "Higher timeframe", group = "Data")
color bullishColor = input.color(color.new(color.teal, 80), "Bullish candle", group = "Appearance")
color bearishColor = input.color(color.new(color.red, 80), "Bearish candle", group = "Appearance")
bool showWicks = input.bool(true, "Show wicks", group = "Appearance")

if timeframe.in_seconds(higherTimeframe) <= timeframe.in_seconds()
    runtime.error("Choose a timeframe higher than the chart timeframe.")

// Each expression is offset inside the requested timeframe.
// lookahead_on makes the last confirmed candle available at the new HTF period.
[htfOpen, htfHigh, htfLow, htfClose] = request.security(
     syminfo.tickerid, higherTimeframe, [open[1], high[1], low[1], close[1]],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

color candleColor = htfClose >= htfOpen ? bullishColor : bearishColor
color outlineColor = color.new(candleColor, 25)

// Repeats the last closed HTF candle across the current lower-timeframe bars.
plotcandle(htfOpen, htfHigh, htfLow, htfClose, title = "Last confirmed HTF candle",
     color = candleColor, wickcolor = showWicks ? outlineColor : na, bordercolor = outlineColor)
